@page "/kalender"
@rendermode InteractiveServer
@inject RaceWeekendService CalendarService
@inject ILogger<RaceCalender> Logger

<PageTitle>Rennkalender | F1 Dashboard</PageTitle>
<div class="race-calendar race-shell">
    <header class="page-heading"><div>
        <p class="eyebrow">FORMULA 1 · SAISON @selectedYear</p>
        <h1>Rennkalender</h1><p>@(Archive ? "Alle Rennwochenenden dieser Saison mit Zeitplan und Ergebnissen." : "Dein Fahrplan zum nächsten Grand Prix.")</p>
    </div></header>
    <div class="toolbar calendar-toolbar">
        <label class="season">Saison
            <select aria-label="Saison auswählen" @bind="selectedYear" @bind:after="OnYearChanged" disabled="@loading">
                @foreach (var year in seasons)
                { <option value="@year">@year</option> }
            </select>
        </label>
        @if (!Archive) { <label class="past-toggle"><input type="checkbox" role="switch" @bind="showPast" /> Vergangene Rennen</label> }
        <label class="past-toggle"><input type="checkbox" role="switch" @bind="useTrackTime" /> Streckenzeit</label>
        <button type="button" class="refresh" @onclick="RefreshRaces" disabled="@loading"><Icon Name="refresh-cw" /> Aktualisieren</button>
        <a class="refresh calendar-export" href="@(Archive ? $"/rennkalender/export/{selectedYear}" : "/rennkalender/export")" download><Icon Name="download" /> Kalender exportieren</a>
    </div>
    <p class="time-zone">@(useTrackTime ? "Alle Uhrzeiten: Ortszeit der jeweiligen Strecke. Die Zeitzone steht beim Rennwochenende." : "Alle Uhrzeiten: Österreich (Europe/Vienna), inklusive Sommer-/Winterzeit.")</p>
    @if (error is not null) { <ApiErrorPanel Error="error" OnRetry="RefreshRaces" /> }
    @if (loading)
    { <div class="loading-state" role="status"><span class="spinner-border spinner-border-sm"></span> Rennkalender für @selectedYear wird geladen …</div> }
    else if (error is null && !VisibleRaces.Any())
    {
        <div class="notice">
            @if (races.Count == 0) { <span>Für @selectedYear sind noch keine Rennen veröffentlicht.</span> }
            else { <span>Für @selectedYear stehen keine weiteren Rennen an. Blende vergangene Rennen ein, um Ergebnisse anzusehen.</span> }
        </div>
    }
    else if (error is null)
    {
        <section class="months" aria-label="Rennen nach Monaten">
            @foreach (var month in VisibleRaces.GroupBy(r => RaceDisplay.RaceDate(r, useTrackTime).Month))
            {
                <section class="month-card">
                    <div class="month-header"><h2>@(new DateTime(selectedYear, month.Key, 1).ToString("MMMM", RaceDisplay.Culture))</h2><span>@month.Count() Rennen</span></div>
                    <div class="month-races">
                        @foreach (var race in month)
                        {
                            <article class="weekend-card">
                                <a class="race" href="@($"{race.Url}?vergangen={showPast.ToString().ToLowerInvariant()}&streckenzeit={useTrackTime.ToString().ToLowerInvariant()}")" aria-label="@($"Details zu {race.Name}")">
                                    <div class="race-art"><span class="round-tag">RUNDE @race.Round.ToString("00")</span><VenueFlag Circuit="@race.CircuitId" Country="@race.Country" />
                                        @if (ArchiveArtwork.Map(race) is { } outline) { <img class="outline" src="@outline" alt="@race.CircuitName" loading="lazy" /> }
                                    </div><div class="race-copy"><div class="race-date"><span class="day">@RaceDisplay.RaceDate(race, useTrackTime).Day.ToString("00")</span><span class="weekday">@RaceDisplay.RaceDate(race, useTrackTime).ToString("ddd", RaceDisplay.Culture)</span></div>
                                    <div class="race-info"><h3>@race.Name</h3><p>@race.Location, @race.Country</p><span class="circuit">@race.CircuitName</span></div>
                                    </div><div class="race-type"><span>@(race.IsPast(DateTimeOffset.UtcNow) ? "Ergebnisse ansehen" : "Rennwochenende öffnen")</span><b aria-hidden="true">↗</b></div>
                                </a>
                                <dl class="weekend-times">
                                    @if (useTrackTime) { <div><dt>Streckenzeit</dt><dd>@(race.TrackZone ?? RaceDisplay.OffsetLabel(race.TrackOffset))</dd></div> }
                                    @foreach (var session in race.Sessions)
                                    { <div class="@(session.Key == "Race" ? "main-session" : null)"><dt>@session.Name</dt><dd>@RaceDisplay.SessionTime(session, useTrackTime, race.TrackOffset, race.TrackZone)</dd></div> }
                                </dl>
                                @if (!race.IsPast(DateTimeOffset.UtcNow)) { <CircuitPreview @key="race.CircuitId" Race="race" /> }
                            </article>
                        }
                    </div>
                </section>
            }
        </section>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "saison")] public int? Season { get; set; }
    [SupplyParameterFromQuery(Name = "vergangen")] public bool Past { get; set; }
    [SupplyParameterFromQuery(Name = "streckenzeit")] public bool TrackTime { get; set; }
    private int selectedYear = DateTime.UtcNow.Year;
    private IReadOnlyList<int> seasons = [];
    private bool showPast;
    private bool useTrackTime;
    private bool loading = true;
    private ApiLoadError? error;
    private IReadOnlyList<RaceWeekend> races = [];
    private bool Archive => selectedYear < DateTime.UtcNow.Year;
    private IEnumerable<RaceWeekend> VisibleRaces => races.Where(r => Archive || showPast || !r.IsPast(DateTimeOffset.UtcNow));

    protected override async Task OnParametersSetAsync()
    {
        selectedYear = Season ?? DateTime.UtcNow.Year;
        showPast = Past;
        useTrackTime = TrackTime;
        await LoadRaces(false);
    }
    private Task OnYearChanged() => LoadRaces(false);
    private Task RefreshRaces() => LoadRaces(true);
    private async Task LoadRaces(bool refresh)
    {
        loading = true;
        error = null;
        races = [];
        try
        {
            seasons = await CalendarService.GetSeasonsAsync();
            if (seasons.Count == 0) return;
            if (!seasons.Contains(selectedYear)) selectedYear = seasons[0];
            races = await CalendarService.GetSeasonAsync(selectedYear, refresh);
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Could not load calendar for {Year}", selectedYear); error = RaceDisplay.Error(ex); }
        finally { loading = false; }
    }
}
