@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="app-shell">
    <aside class="sidebar">
        <a class="brand" href="/"><span class="brand-mark">F1</span><strong>F1 Dashboard</strong></a>
        <nav aria-label="Hauptnavigation">
            <NavLink href="uebersicht" aria-label="Übersicht" title="Übersicht"><Icon Name="house" /> <span>Übersicht</span></NavLink>
            <NavLink href="rennen" aria-label="Rennen" title="Rennen"><Icon Name="flag" /> <span>Rennen</span></NavLink>
            <NavLink href="fahrer-wm" class="@(Navigation.Uri == Navigation.BaseUri ? "active" : null)" aria-label="Fahrer-WM" title="Fahrer-WM"><Icon Name="trophy" /> <span>Fahrer-WM</span></NavLink>
            <NavLink href="konstrukteurs-wm" aria-label="Konstrukteurs-WM" title="Konstrukteurs-WM"><Icon Name="shield" /> <span>Konstrukteurs-WM</span></NavLink>
            <NavLink href="kalender" aria-label="Kalender" title="Kalender"><Icon Name="calendar-days" /> <span>Kalender</span></NavLink>
            <NavLink href="ergebnisse" aria-label="Ergebnisse" title="Ergebnisse"><Icon Name="list-ordered" /> <span>Ergebnisse</span></NavLink>
            <NavLink href="news" aria-label="News" title="News"><Icon Name="newspaper" /> <span>News</span></NavLink>
            <NavLink href="statistiken" aria-label="Statistiken" title="Statistiken"><Icon Name="chart-no-axes-column-increasing" /> <span>Statistiken</span></NavLink>
        </nav>
        <NavLink class="settings" href="einstellungen" aria-label="Einstellungen" title="Einstellungen"><Icon Name="settings" /> <span>Einstellungen</span></NavLink>
    </aside>
    <main class="main-content">@Body</main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Die Verbindung wurde unterbrochen.
    <a href="." class="reload">Neu laden</a>
    <span class="dismiss">x</span>
</div>
